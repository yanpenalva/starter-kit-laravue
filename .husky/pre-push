#!/usr/bin/env bash

start_time=$(date +%s)
echo "🚀 Executando pre-push hook..."

current_branch=$(git rev-parse --abbrev-ref HEAD)
[ "$current_branch" = "main" ] && { echo "🚫 Branch 'main' detectada. Pulando testes."; exit 0; }

container="starterkit-app"
container_running() {
  docker inspect -f '{{.State.Running}}' "$container" 2>/dev/null | grep -q '^true$'
}
run_tests() {
  local script="$1"
  echo "🧪 Rodando testes (composer $script)..."
  if container_running; then
    docker exec "$container" composer run "$script"
  else
    composer run "$script"
  fi || { echo "❌ Testes falharam."; exit 1; }
}

case "$current_branch" in
  hml) run_tests "test" ;;
  main) exit 0 ;;
  *) run_tests "test:coverage" ;;
esac

end_time=$(date +%s)
echo "✅ Pre-push finalizado com sucesso em $((end_time - start_time))s."
