{
  "name": "starter-kit-laravue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 3000",
    "build-production": "vite build",
    "build-development": "vite build --mode development",
    "build-staging": "vite build --mode staging",
    "serve": "vite preview",
    "lint": "eslint --ext .js,.vue resources/js --max-warnings=0",
    "lint:fix": "eslint --ext .js,.vue --fix resources/js --max-warnings=0",
    "commit": "git-cz",
    "format": "prettier ./resources/js --write",
    "changelog": "changelogen --output CHANGELOG.md",
    "changelog:preview": "changelogen --output CHANGELOG.md --no-commit --no-tag",
    "release": "changelogen --release --push",
    "release:minor": "changelogen --release --minor --push",
    "release:major": "changelogen --release --major --push",
    "release:patch": "changelogen --release --patch --push"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/config-array": "^0.18.0",
    "@eslint/object-schema": "^2.1.0",
    "@quasar/vite-plugin": "^1.9.0",
    "axios": "^1.6.7",
    "changelogen": "^0.6.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-vue": "^10.0.0",
    "husky": "^9.0.11",
    "laravel-vite-plugin": "^1.2.0",
    "patch-package": "^8.0.1",
    "sass-embedded": "^1.83.4",
    "vite": "^6.2.0",
    "vite-plugin-eslint": "^1.8.1",
    "vue-eslint-parser": "^10.1.1"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.16",
    "@tanstack/vue-query": "^5.66.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "date-fns": "^3.3.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "prettier": "^3.2.5",
    "quasar": "^2.17.7",
    "vue": "^3.5.13",
    "vue-loader": "^17.4.2",
    "vue-router": "^4.2.5"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true",
      "pre-commit": "echo \"[Husky] pre-commit\"",
      "pre-push": "echo \"[Husky] pre-push\""
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "resolutions": {
    "esbuild": "^0.25.0"
  },
  "overrides": {
    "glob": "^10.0.0",
    "rimraf": "^5.0.0"
  }
}
